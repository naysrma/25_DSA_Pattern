

def search(arr,target):
    left = 0
    right = len(arr) - 1

    while(left <= right):
        mid = left + (right - left) // 2

        if(arr[mid] == target):
            return mid
        elif(arr[left] <= arr[mid]):
            if(arr[left] <= target and target < arr[mid]):
                right = mid - 1
            else:
                left = mid + 1

    return -1

arr = [4,5,6,7,0,1,2]
target = 1
print(search(arr, target))